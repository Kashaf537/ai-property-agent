      ],
      "id": "162d622a-eefd-42ae-af62-a048da7adef6",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "YweDCmI06J8pvs6G",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"properties\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"location\": {\n            \"type\": \"string\"\n          },\n          \"size\": {\n            \"type\": \"string\"\n          },\n          \"bedrooms\": {\n            \"type\": \"integer\"\n          },\n          \"bathrooms\": {\n            \"type\": \"integer\"\n          },\n          \"price_pkr\": {\n            \"type\": \"integer\"\n          }\n        },\n        \"required\": [\n          \"location\",\n          \"size\",\n          \"bedrooms\",\n          \"bathrooms\",\n          \"price_pkr\"\n        ]\n      }\n    },\n    \"total_properties\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": [\n    \"properties\",\n    \"total_properties\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1232,
        96
      ],
      "id": "ccc1d20d-224c-4040-aca3-0876fc8e1f0f",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.output;\n\nlet message = \"🏠 Here are the properties matching your requirements:\\n\\n\";\n\ndata.properties.forEach((property, index) => {\n  message += `${index + 1}. ${property.location}\\n`;\n  message += `📐 Size: ${property.size}\\n`;\n  message += `🛏️ Bedrooms: ${property.bedrooms}\\n`;\n  message += `🛁 Bathrooms: ${property.bathrooms}\\n`;\n  message += `💰 Price: PKR ${property.price_pkr.toLocaleString()}\\n`;\n  message += `\\n`;  // blank line between properties\n});\n\nmessage += `I found ${data.total_properties} matching properties.`;\n\nreturn [\n  {\n    json: {\n      message: message\n    }\n  }\n];"
      },
